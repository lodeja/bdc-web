{
  "name": "jdc-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/defer-hydration.mjs && node scripts/og-png.mjs",
    "build:pages": "GITHUB_PAGES=true next build && node scripts/defer-hydration.mjs && node scripts/og-png.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "preview": "node scripts/static-server.mjs",
    "copy:extract": "node scripts/copy-check/extract-text.mjs",
    "copy:vale": "vale --output=JSON --no-exit .copy-text | node scripts/copy-check/vale-gate.mjs",
    "copy:lt": "node scripts/copy-check/languagetool.mjs",
    "copy:readability": "python3 scripts/copy-check/readability.py",
    "copy:check": "npm run copy:extract && npm run copy:vale && npm run copy:lt && npm run copy:readability",
    "lhci": "lhci autorun --config=lighthouserc.mobile.cjs && lhci autorun --config=lighthouserc.desktop.cjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
